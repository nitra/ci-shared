{
  "name": "@nitra/ci-shared",
  "version": "1.2.1",
  "description": "Nitra CI tooling: sync GraphQL schema to a docs npm package (and more to come).",
  "homepage": "https://github.com/nitra/ci-shared",
  "bugs": {
    "url": "https://github.com/nitra/ci-shared/issues"
  },
  "license": "ISC",
  "author": "v@nitra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitra/ci-shared.git"
  },
  "bin": {
    "ci-shared": "src/cli.mjs"
  },
  "files": [
    "src",
    "types",
    "CHANGELOG.md",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/test/**",
    "!**/tests/**",
    "!**/fixtures/**",
    "!**/__fixtures__/**",
    "!**/__tests__/**"
  ],
  "type": "module",
  "types": "./types/cli.d.mts",
  "exports": {
    "./opentofu": {
      "types": "./types/opentofu/contract.d.mts",
      "import": "./src/opentofu/contract.mjs"
    },
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@graphql-inspector/core": "^7.1.3",
    "graphql": "^16.14.2"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
